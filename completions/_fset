#compdef fset

autoload -U is-at-least

_fset() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_fset_commands" \
"*::: :->fset" \
&& ret=0
    case $state in
    (fset)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:fset-command-$line[1]:"
        case $line[1] in
            (get)
_arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':key:_default' \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':key:_default' \
':value:_default' \
&& ret=0
;;
(unset)
_arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
':key:_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
'::section:_default' \
&& ret=0
;;
(path)
_arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(edit)
_arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(reset)
_arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'-h[Print help]' \
'--help[Print help]' \
'::section:_default' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--dir=[Install into this directory instead of searching. Implies --install]:DIR:_files' \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'--install[Write the script into the shell'\''s completion directory]' \
'-h[Print help]' \
'--help[Print help]' \
'::shell -- Detected from $SHELL when omitted:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_fset__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:fset-help-command-$line[1]:"
        case $line[1] in
            (get)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(unset)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(path)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(edit)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(reset)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_fset_commands] )) ||
_fset_commands() {
    local commands; commands=(
'get:Print the current value, or "unset" if absent' \
'set:Set a value, validated against the same types fsapp'\''s CLI uses' \
'unset:Remove a key — reverts to the file-engine builder default' \
'list:Dump current JSON (optionally scoped to one section)' \
'path:Print the resolved config file path' \
'edit:Open \$EDITOR on the file; re-validate before saving' \
'reset:Reset the whole file (or one section) to {}; always backs up first' \
'completions:Print a shell completion script, or install it with --install' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'fset commands' commands "$@"
}
(( $+functions[_fset__subcmd__completions_commands] )) ||
_fset__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'fset completions commands' commands "$@"
}
