#compdef fsapp

autoload -U is-at-least

_fsapp() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_fsapp_commands" \
"*::: :->fsapp" \
&& ret=0
    case $state in
    (fsapp)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:fsapp-command-$line[1]:"
        case $line[1] in
            (copy)
_arguments "${_arguments_options[@]}" : \
'--small-file-threshold=[]:SMALL_FILE_THRESHOLD:_default' \
'--batch-concurrency=[]:BATCH_CONCURRENCY:_default' \
'--on-error=[]:ON_ERROR:(continue abort undo)' \
'--max-bytes-per-batch=[]:MAX_BYTES_PER_BATCH:_default' \
'--max-files-per-batch=[]:MAX_FILES_PER_BATCH:_default' \
'--sort-order=[]:SORT_ORDER:(asc desc)' \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'--preserve-permissions[]' \
'--allow-fs-integrity-risk[]' \
'--overwrite[]' \
'--skip-if-identical[Only consulted with --overwrite unset\: an already-identical destination is left alone instead of failing; a genuinely different one still fails]' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
':source:_files' \
':dest:_files' \
&& ret=0
;;
(mv)
_arguments "${_arguments_options[@]}" : \
'--small-file-threshold=[]:SMALL_FILE_THRESHOLD:_default' \
'--batch-concurrency=[]:BATCH_CONCURRENCY:_default' \
'--on-error=[]:ON_ERROR:(continue abort undo)' \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'--preserve-permissions[]' \
'--allow-fs-integrity-risk[]' \
'--overwrite[]' \
'--skip-if-identical[Only consulted with --overwrite unset\: an already-identical destination is left alone instead of failing; a genuinely different one still fails]' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
':source:_files' \
':dest:_files' \
&& ret=0
;;
(mv-many)
_arguments "${_arguments_options[@]}" : \
'--small-file-threshold=[]:SMALL_FILE_THRESHOLD:_default' \
'--batch-concurrency=[]:BATCH_CONCURRENCY:_default' \
'--on-error=[]:ON_ERROR:(continue abort undo)' \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'--preserve-permissions[]' \
'--allow-fs-integrity-risk[]' \
'--overwrite[]' \
'--skip-if-identical[Only consulted with --overwrite unset\: an already-identical destination is left alone instead of failing; a genuinely different one still fails]' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
'*::sources:_files' \
':dest:_files' \
&& ret=0
;;
(sync)
_arguments "${_arguments_options[@]}" : \
'--small-file-threshold=[]:SMALL_FILE_THRESHOLD:_default' \
'--batch-concurrency=[]:BATCH_CONCURRENCY:_default' \
'--on-error=[]:ON_ERROR:(continue abort undo)' \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'--preserve-permissions[]' \
'--allow-fs-integrity-risk[]' \
'--no-overwrite[Inverts the builder'\''s default of \`true\`]' \
'--checksum[]' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
':source:_files' \
':dest:_files' \
&& ret=0
;;
(watch)
_arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'--no-recursive[Inverts the builder'\''s default of \`true\`]' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
':path:_files' \
&& ret=0
;;
(compress)
_arguments "${_arguments_options[@]}" : \
'--small-file-threshold=[]:SMALL_FILE_THRESHOLD:_default' \
'--batch-concurrency=[]:BATCH_CONCURRENCY:_default' \
'--on-error=[]:ON_ERROR:(continue abort undo)' \
'--format=[Inferred from DEST'\''s extension if omitted]:FORMAT:(zip gzip)' \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
':source:_files' \
':dest:_files' \
&& ret=0
;;
(analyze)
_arguments "${_arguments_options[@]}" : \
'*--extensions=[Only files with one of these extensions (no leading dot)]:EXTENSIONS:_default' \
'*--exclude=[Glob patterns, matched relative to PATH, that prune traversal]:EXCLUDE:_default' \
'--min-size=[]:MIN_SIZE:_default' \
'--max-size=[]:MAX_SIZE:_default' \
'--max-depth=[]:MAX_DEPTH:_default' \
'--top-n-largest=[How many of the largest matched files to list. 0 disables it]:TOP_N_LARGEST:_default' \
'--walk-concurrency=[Worker threads for concurrent directory reads/stats. Defaults to available parallelism]:WALK_CONCURRENCY:_default' \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'--follow-symlinks[]' \
'--detect-mime-types[Sniff each matched file'\''s header to classify its MIME type]' \
'--detect-duplicates[Content-hash size-colliding files to find exact duplicates]' \
'--abort-on-error[Stop at the first error instead of skipping and collecting it]' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
':path:_files' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'*--extensions=[Only files with one of these extensions (no leading dot)]:EXTENSIONS:_default' \
'*--exclude=[Glob patterns, matched relative to PATH, that spare an otherwise-matching entry]:EXCLUDE:_default' \
'--min-size=[]:MIN_SIZE:_default' \
'--max-size=[]:MAX_SIZE:_default' \
'--modified-after=[RFC3339 timestamp, e.g. 2026-01-01T00\:00\:00Z]:MODIFIED_AFTER:_default' \
'--modified-before=[RFC3339 timestamp, e.g. 2026-01-01T00\:00\:00Z]:MODIFIED_BEFORE:_default' \
'--max-depth=[]:MAX_DEPTH:_default' \
'--on-error=[]:ON_ERROR:(continue abort undo)' \
'--batch-concurrency=[]:BATCH_CONCURRENCY:_default' \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'--follow-symlinks[]' \
'--no-dry-run[Inverts the builder'\''s default of \`true\`\: actually delete matches instead of only previewing them]' \
'--hard-delete[Unlink matches permanently instead of moving them to the platform trash/recycle bin]' \
'--allow-unfiltered-delete[Required to proceed when no filter criterion above is set — otherwise an unfiltered PATH (matching everything under it) is refused before anything is touched]' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
':path:_files' \
&& ret=0
;;
(update-check)
_arguments "${_arguments_options[@]}" : \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--dir=[Install into this directory instead of searching. Implies --install]:DIR:_files' \
'--config=[Override the config file location for this invocation]:CONFIG:_files' \
'--install[Write the script into the shell'\''s completion directory]' \
'*-v[-v info, -vv debug, -vvv trace (default\: warn)]' \
'-q[Suppress the progress bar; logging still follows -v]' \
'--quiet[Suppress the progress bar; logging still follows -v]' \
'--no-update-check[Skip the automatic check for a newer fsapp release]' \
'-h[Print help]' \
'--help[Print help]' \
'::shell -- Detected from $SHELL when omitted:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_fsapp__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:fsapp-help-command-$line[1]:"
        case $line[1] in
            (copy)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(mv)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(mv-many)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(sync)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(watch)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(compress)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(analyze)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(update-check)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_fsapp_commands] )) ||
_fsapp_commands() {
    local commands; commands=(
'copy:Copy files from SOURCE to DEST' \
'mv:Move files from SOURCE to DEST' \
'mv-many:Move several independent SOURCES into one DEST directory as a single batched operation — each source keeps its own basename under DEST, which must be a directory sources land inside, never a rename target the way \`mv\`'\''s DEST can be' \
'sync:Sync DEST to match SOURCE (copies changes, deletes orphans)' \
'watch:Watch PATH for filesystem changes and print events until Ctrl+C' \
'compress:Compress SOURCE into an archive at DEST' \
'analyze:Inspect a tree read-only\: counts, sizes, largest files, extension and age breakdowns, and optionally MIME types and duplicates' \
'remove:Delete files under PATH matching the given criteria. Previews matches without touching anything unless --no-dry-run is passed, and refuses to run at all with no filter criteria set unless --allow-unfiltered-delete opts in explicitly — deliberately no config-file section for this command\: a destructive default (hard-delete, or an unfiltered delete) has no business sitting in a JSON file that isn'\''t part of the invocation you'\''re looking at' \
'update-check:Check whether a newer fsapp release is available' \
'completions:Print a shell completion script, or install it with --install' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'fsapp commands' commands "$@"
}
